# dependencies and build output
node_modules/
dist/
.astro/

# review screenshots are regenerated from the running site on demand,
# and git keeps every blob forever, so 6.5MB of PNGs stay out of history
design/review/

# superseded procedural texture output; the scripts that make them are tracked
design/generated/*.jpg

# local tooling and OS noise
.claude/settings.local.json
.DS_Store
*.log

# python bytecode
__pycache__/
*.pyc
