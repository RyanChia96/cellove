---
import Page from '../layouts/Page.astro';
import ImageBand from '../components/ImageBand.astro';
import JournalIndex from '../components/JournalIndex.astro';

const title = 'The Cellove Journal | Cellove Wellness';
const description =
  'Plain explanations of how cellular health works: how to weigh a health claim, what absorption means, and how to tell evidence from a marketing cycle.';
---
<Page title={title} description={description}>
  <ImageBand src="/media/journal-band.jpg" alt="A warm plaster surface in raking daylight." />
  {/* total is 1 because only these three posts exist. Pagination renders no
      links to pages that are not there, so crawlers are never fed 404s. */}
  <JournalIndex current={1} total={1} count={3} />
</Page>
