import Hero from '../components/Hero.astro';
import WhyUs from '../components/WhyUs.astro';
import Philosophy from '../components/Philosophy.astro';
import HealthBento from '../components/HealthBento.astro';
import JournalTeaser from '../components/JournalTeaser.astro';

// MEDICAL AND LEGAL REVIEW REQUIRED. No outcome, efficacy or treatment claim is made.
