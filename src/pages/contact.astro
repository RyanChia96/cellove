---
import Page from '../layouts/Page.astro';
import PageHead from '../components/PageHead.astro';
import { BUSINESS } from '../lib/legal';
import { WHATSAPP_HREF } from '../lib/site';

const title = 'Contact Us | Cellove Wellness';
const description =
  'Start your Cellove journey. Message us on WhatsApp or send an enquiry and we will tell you whether we are the right people for it.';

// Hours are still to be confirmed.
const details = [
  ['WhatsApp', BUSINESS.whatsapp, WHATSAPP_HREF],
  ['Email', BUSINESS.email, `mailto:${BUSINESS.email}`],
  ['Clinic', BUSINESS.clinicAddress],
  ['Hours', 'Opening hours to be confirmed'],
] as [string, string, string?][];
---
<Page title={title} description={description} formGround="beige">
  <PageHead
    eyebrow="Contact"
    heading="Your journey to better health begins here."
    body="Every health journey is personal. At Cellove Wellness, we bring together medical expertise, scientific understanding and a cellular perspective to help you explore the possibilities for your health."
  />

  <section class="ground-white">
    <div class="mx-auto grid max-w-[1440px] gap-12 px-5 pb-20 sm:px-8 lg:grid-cols-12 lg:gap-16 lg:pb-24">
      <div class="lg:col-span-6">
        <dl class="grid gap-0" data-reveal>
          {details.map(([k, v, href], i) => (
            <div class="py-6" style={i === 0 ? '' : 'border-top: 1px solid var(--hairline);'}>
              <dt class="label">{k}</dt>
              <dd class="mt-2 text-[1rem]" style="color: var(--ink);">
                {href ? <a href={href} class="underline-offset-4 hover:underline">{v}</a> : v}
              </dd>
            </div>
          ))}
        </dl>
      </div>
      <div class="lg:col-span-6" data-reveal>
        <img
          src="/media/contact-clinic.jpg"
          alt="The arrival space at the clinic."
          loading="lazy" decoding="async" width="1200" height="800"
          class="w-full object-cover"
          style="aspect-ratio: 3 / 2; background: var(--beige);"
        />
      </div>
    </div>
  </section>
</Page>
