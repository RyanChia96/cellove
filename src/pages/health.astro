---
import Page from '../layouts/Page.astro';
import PageHead from '../components/PageHead.astro';
import Health from '../components/Health.astro';
import Journey from '../components/Journey.astro';
import CtaBand from '../components/CtaBand.astro';

const title = 'Preventive Healthcare & Wellness in KL | Cellove Wellness';
const description =
  'Preventive healthcare at a doctor-led wellness centre in Kuala Lumpur: the areas of health people bring to Cellove, and how each case is followed through.';
---
<Page title={title} description={description} formGround="beige">
  <PageHead
    eyebrow="Health & Wellness"
    heading="What people come to us about."
    body="Whether any approach suits you is decided in consultation with a doctor, never from a list on a website."
  />
  <Health />
  <Journey />
  <CtaBand
    heading="Not sure which of these is yours?"
    body="That is a normal place to start. Tell us the symptom or the goal and we will take it from there."
    label="Contact Us"
    href="/contact"
  />
</Page>
