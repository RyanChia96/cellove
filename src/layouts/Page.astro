---
/**
 * Page shell. Every route gets the same chrome: nav at the top, contact form
 * and footer at the bottom, and the WhatsApp float above everything.
 */
import Base from './Base.astro';
import Nav from '../components/Nav.astro';
import ContactForm from '../components/ContactForm.astro';
import Footer from '../components/Footer.astro';
import WhatsAppFab from '../components/WhatsAppFab.astro';

interface Props {
  title: string;
  description: string;
  formGround?: string;
  /** The first section runs underneath the floating nav (the homepage hero). */
  overlayNav?: boolean;
}
const { title, description, formGround = 'white', overlayNav = false } = Astro.props;
---
<Base title={title} description={description}>
  <Nav />
  <main id="main" class={overlayNav ? '' : 'pt-[68px] lg:pt-[106px]'}>
    <slot />
    <ContactForm ground={formGround} />
  </main>
  <Footer />
  <WhatsAppFab />
</Base>
