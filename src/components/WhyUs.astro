---
/**
 * Section 2, one connected block. Myth graph, the philosophy band, the three
 * pillars and two CTAs all live here rather than as separate sections,
 * because they make one argument: here is how health claims get weighed,
 * here is what we believe, here is what we look at.
 *
 * Beige ground with a single dark band inside it. Dark is used twice on the
 * whole site: this band and the footer.
 */
import { Icon } from 'astro-icon/components';
import FigEvidence from './FigEvidence.astro';
import { WHATSAPP_HREF } from '../lib/site';

const pillars = [
  { icon: 'atom', k: 'Cell technology', d: 'Which cellular approach fits the question being asked, and when none of them does.' },
  { icon: 'drop-half', k: 'Absorption science', d: 'How an intervention reaches the body, and how much arrives in usable form.' },
  { icon: 'chart-line', k: 'Science and data', d: 'What current evidence supports, where it thins out, and where it stops.' },
];
---
<section id="why-us" class="ground-beige edge-top">
  <div class="mx-auto grid max-w-[1440px] gap-12 px-5 pt-20 pb-16 sm:px-8 lg:grid-cols-12 lg:gap-14 lg:pt-24">
    <div class="lg:col-span-5">
      <p class="label" data-reveal>Why us</p>
      <h2 class="display mt-5 text-[2.1rem] sm:text-[2.6rem] lg:text-[2.9rem]" data-reveal>
        Your Health Deserves Better Than Internet Myths.
      </h2>
      <p class="annot mt-9 max-w-[24ch]" data-reveal>
        Ask what kind of evidence sits underneath the claim.
      </p>
    </div>
    <div class="lg:col-span-7" data-reveal>
      <div class="sheet p-6 sm:p-8">
        <FigEvidence />
      </div>
    </div>
  </div>

  <div class="ground-dark">
    <div class="mx-auto grid max-w-[1440px] gap-8 px-5 py-16 sm:px-8 lg:grid-cols-12 lg:gap-14 lg:py-20">
      <div class="lg:col-span-7">
        <p class="label" data-reveal>The fundamental philosophy</p>
        <h2 class="display mt-5 text-[2rem] sm:text-[2.6rem]" data-reveal>Patient First. Science First.</h2>
        <p class="mt-6 text-[1.1rem]" style="color: var(--annot-on-dark);" data-reveal>
          We don&rsquo;t follow health trends. We follow science.
        </p>
      </div>
      <div class="lg:col-span-5 lg:pt-14" data-reveal>
        <p class="max-w-[42ch] text-[1rem] leading-relaxed" style="color: var(--on-dark-soft);">
          Every recommendation starts with the patient. Every treatment needs a
          reason behind it that holds up.
        </p>
      </div>
    </div>
  </div>

  <div class="mx-auto max-w-[1440px] px-5 py-16 sm:px-8 lg:py-20">
    <div class="grid gap-5 md:grid-cols-3">
      {pillars.map((p) => (
        <article class="sheet flex flex-col p-8" data-reveal>
          <img src={`/media/icons/${p.icon}.svg`} alt="" aria-hidden="true" width="40" height="40" class="h-10 w-10" />
          <h3 class="display mt-6 text-[1.5rem]">{p.k}</h3>
          <p class="mt-3 text-[0.95rem] leading-relaxed">{p.d}</p>
          <div class="ruler mt-auto pt-8"></div>
        </article>
      ))}
    </div>

    <div class="mt-14 flex flex-col gap-6 lg:flex-row lg:items-center lg:justify-between" data-reveal>
      <h3 class="display max-w-[20ch] text-[1.7rem] sm:text-[2rem]">Read the detail, or just ask us.</h3>
      <div class="flex flex-col gap-3 sm:flex-row sm:items-center sm:gap-4">
        <a
          href="/science"
          class="inline-flex items-center justify-center gap-2 whitespace-nowrap rounded-full px-7 py-3.5 text-[0.9rem] font-medium transition-transform duration-200 hover:-translate-y-px active:scale-[0.98]"
          style="background: var(--ink); color: var(--white);"
        >
          Read Our Science
          <Icon aria-hidden="true" name="ph:arrow-right" class="h-4 w-4" />
        </a>
        <a
          href={WHATSAPP_HREF}
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center justify-center gap-2 whitespace-nowrap rounded-full px-7 py-3.5 text-[0.9rem] font-medium transition-transform duration-200 hover:-translate-y-px active:scale-[0.98]"
          style="border: 1px solid var(--ink); color: var(--ink);"
        >
          <Icon aria-hidden="true" name="ph:whatsapp-logo" class="h-4 w-4" />
          Ask on WhatsApp
        </a>
      </div>
    </div>
  </div>
</section>
