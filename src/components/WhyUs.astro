---
/**
 * Section 2. The myth question, centred on graph paper.
 *
 * The eyebrow is gone and the annotation has become a plain centred standfirst:
 * the heading is the whole statement here, and a handwritten note rotated off
 * axis would fight a centred axis rather than sit beside it.
 *
 * The philosophy statement, the three pillars and the two CTAs used to live
 * here too; they now sit in Philosophy.astro as their own section. This one
 * asks the question, that one answers it.
 */
import FigEvidence from './FigEvidence.astro';
---
<section id="why-us" class="ground-white paper-grid edge-top">
  <div class="mx-auto max-w-[1440px] px-5 pt-28 pb-20 sm:px-8 lg:pt-32 lg:pb-24">
    <h2 class="display text-center text-[2.1rem] leading-[1.14] sm:text-[2.6rem] lg:text-[3.1rem]" data-reveal>
      <span class="block">Your Health Deserves</span>
      <span class="block">Better Than Internet Myths.</span>
    </h2>
    <p
      class="mx-auto mt-5 max-w-[52ch] text-center text-[0.95rem] leading-relaxed"
      style="color: var(--graphite);"
      data-reveal
    >
      Ask what kind of evidence sits underneath the claim.
    </p>

    <div class="sheet mx-auto mt-16 max-w-[62rem] px-6 py-12 sm:px-12 sm:py-16" data-reveal>
      <FigEvidence />
    </div>
  </div>
</section>
