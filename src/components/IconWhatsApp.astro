---
/**
 * The official WhatsApp glyph, supplied by the client.
 *
 * Inlined rather than loaded through <img>, because an <img> is a separate
 * document and currentColor cannot cross that boundary: the icon would render
 * black regardless of the colour set on its container. That is the same bug
 * the footer social icons had.
 *
 * The source file hard-codes fill="white" and wraps the path in a clipPath.
 * Both are dropped here: the fill becomes currentColor so one glyph serves
 * the white-on-green button and the ink-on-light buttons alike, and the clip
 * was a full-viewBox rect that clipped nothing while introducing an id that
 * would repeat on any page showing the glyph twice.
 */
interface Props {
  class?: string;
}
const { class: className = 'h-4 w-4' } = Astro.props;
---
