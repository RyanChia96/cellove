---
/** Journal teaser. Topics are taken directly from the brief's own list so no
 *  article is implied to exist that the clinic has not planned. */
import { Icon } from 'astro-icon/components';
const topics = [
  { title: 'How to evaluate a health claim', note: 'The questions worth asking before you believe anything.' },
  { title: 'Understanding absorption', note: 'Why what you take and what your body uses are not the same thing.' },
  { title: 'Science versus health trends', note: 'How to tell an evidence base from a marketing cycle.' },
];
---
<section id="journal" style="background: color-mix(in srgb, var(--stone) 42%, var(--paper));">
  <div class="mx-auto max-w-[1400px] px-5 py-24 sm:px-8 lg:py-32">
    <h2 class="display max-w-[20ch] text-[2.1rem] sm:text-[2.6rem] lg:text-[2.9rem]" data-reveal>
      The Cellove Journal
    </h2>
    <p class="mt-6 max-w-[48ch] text-[1.02rem] leading-relaxed" data-reveal>
      Plain explanations of how cellular health works, written to be understood
      rather than to impress.
    </p>

    <div class="mt-14 grid gap-px" style="background: var(--hairline);">
      {topics.map((t) => (
        <a
          href="#journal"
          class="group flex flex-col gap-2 p-7 transition-colors duration-200 sm:flex-row sm:items-baseline sm:justify-between sm:gap-8 sm:p-8"
          style="background: var(--paper);"
          data-reveal
        >
          <h3 class="display text-[1.4rem] sm:text-[1.6rem]">{t.title}</h3>
          <span class="flex items-center gap-3 text-[0.92rem] sm:text-right" style="color: var(--ink-soft);">
            {t.note}
            <Icon aria-hidden="true" name="ph:arrow-up-right" class="h-4 w-4 shrink-0 transition-transform duration-200 group-hover:translate-x-0.5" style="color: var(--rose-deep);" />
          </span>
        </a>
      ))}
    </div>
    <p class="mt-6 text-[0.85rem]" style="color: var(--ink-soft);" data-reveal>
      Writing is in preparation. {/* TODO: point these at real posts once published */}
    </p>
  </div>
</section>
