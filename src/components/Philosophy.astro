---
/**
 * The science beat: a pill eyebrow, a centred heading and three photographic
 * cards, each with an icon, a title and one line.
 *
 * PLACEHOLDER COPY. Wording is to be replaced after the SEO research.
 *
 * Text sits directly on the photograph, so each card sets its own tone:
 * the two darker photographs take a bottom scrim and white type, the pale skin
 * photograph takes ink type and no scrim. Keep that pairing if the images are
 * swapped, and re-check contrast when they are.
 */
const cards = [
  {
    img: 'science-cellular', icon: 'atom', tone: 'dark',
    k: 'Cellular Understanding',
    d: 'Explore the science of health at its most fundamental level.',
    alt: 'A translucent glass DNA helix against folds of green silk.',
  },
  {
    img: 'science-regenerative', icon: 'drop-half', tone: 'light',
    k: 'Regenerative and cellular health',
    d: 'Understand how delivery methods can influence the availability of different substances in the body.',
    alt: 'A single droplet of clear serum on a forearm.',
  },
  {
    img: 'science-evidence', icon: 'chart-line', tone: 'dark',
    k: 'Evidence over hype',
    d: 'Make informed choices guided by research, transparency and medical expertise.',
    alt: 'A glass petri dish with a culture on a white laboratory bench.',
  },
] as const;
---
<section id="philosophy" class="edge-top" style="background: color-mix(in srgb, var(--beige) 45%, var(--white));">
  <div class="mx-auto max-w-[1440px] px-5 py-20 sm:px-8 lg:py-28">
    <div class="text-center">
      <p class="label inline-block rounded-full px-5 py-2.5" style="background: var(--beige-deep);" data-reveal>Our Science</p>
      <h2 class="display mx-auto mt-5 max-w-[18ch] text-[2.1rem] leading-[1.14] sm:text-[2.6rem] lg:text-[3.1rem]" data-reveal>
        Better Health Begins With Understanding
      </h2>
    </div>

    <div class="mx-auto mt-12 grid gap-5 md:grid-cols-3 lg:mt-14">
      {cards.map((c) => (
        <article class="relative flex aspect-[419/547] flex-col justify-end overflow-hidden" data-reveal>
          <img
            src={`/media/${c.img}.webp`} alt={c.alt}
            width="419" height="547" loading="lazy" decoding="async"
            class="absolute inset-0 h-full w-full object-cover"
          />
          {c.tone === 'dark' && (
            <div
              class="absolute inset-0"
              style="background: linear-gradient(to top, rgb(0 0 0 / 0.62) 0%, rgb(0 0 0 / 0.3) 38%, transparent 62%);"
              aria-hidden="true"
            ></div>
          )}
          <div
            class="relative p-6"
            style={`color: ${c.tone === 'dark' ? '#fff' : 'var(--ink)'};`}
          >
            <img
              src={`/media/icons/${c.icon}.svg`} alt="" aria-hidden="true"
              width="28" height="28" class="h-7 w-7"
              style={c.tone === 'dark' ? 'filter: brightness(0) invert(1);' : ''}
            />
            <h3 class="mt-4 text-[1.3rem] leading-snug" style="font-weight: 400;">{c.k}</h3>
            <p class="mt-2 text-[0.82rem] leading-relaxed" style="opacity: 0.92;">{c.d}</p>
          </div>
        </article>
      ))}
    </div>
  </div>
</section>
