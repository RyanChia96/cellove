---
/**
 * The philosophy beat, lifted out of WhyUs into its own section so it sits
 * directly above Health & Wellness.
 *
 * It used to run as a dark band plus a separate pillar grid plus a separate
 * CTA row: three stacked blocks saying one thing. Here the statement, the
 * three things we look at and the two ways to continue sit on one sheet of
 * paper, which is how the notebook system wants it.
 */
import { Icon } from 'astro-icon/components';
import IconWhatsApp from './IconWhatsApp.astro';
import { WHATSAPP_HREF } from '../lib/site';

const pillars = [
  { icon: 'atom', k: 'Cell technology', d: 'Which cellular approach fits the question being asked, and when none of them does.' },
  { icon: 'drop-half', k: 'Absorption science', d: 'How an intervention reaches the body, and how much arrives in usable form.' },
  { icon: 'chart-line', k: 'Science and data', d: 'What current evidence supports, where it thins out, and where it stops.' },
];
---
<section id="philosophy" class="ground-beige edge-top">
  <div class="mx-auto max-w-[1440px] px-5 py-20 sm:px-8 lg:py-24">
    <div class="grid gap-10 lg:grid-cols-12 lg:gap-14">
      <div class="lg:col-span-7">
        <p class="label" data-reveal>The fundamental philosophy</p>
        <h2 class="display mt-5 text-[2.1rem] sm:text-[2.6rem] lg:text-[2.9rem]" data-reveal>
          Patient First. Science First.
        </h2>
        <p class="mt-6 max-w-[44ch] text-[1.02rem] leading-relaxed" data-reveal>
          Every recommendation starts with the patient. Every treatment needs a
          reason behind it that holds up.
        </p>
      </div>

      <div class="flex flex-col gap-8 lg:col-span-5 lg:items-end lg:justify-between lg:gap-0">
        <p class="annot lg:text-right" data-reveal>
          <span class="block">We don&rsquo;t follow health trends.</span>
          <span class="block">We follow science.</span>
        </p>
        <div class="flex flex-col gap-3 sm:flex-row sm:items-center sm:gap-4" data-reveal>
          <a
            href="/science"
            class="inline-flex items-center justify-center gap-2 whitespace-nowrap rounded-full px-7 py-3.5 text-[0.9rem] font-medium transition-transform duration-200 hover:-translate-y-px active:scale-[0.98]"
            style="background: var(--ink); color: var(--white);"
          >
            Read Our Science
            <Icon aria-hidden="true" name="ph:arrow-right" class="h-4 w-4" />
          </a>
          <a
            href={WHATSAPP_HREF}
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center justify-center gap-2 whitespace-nowrap rounded-full px-7 py-3.5 text-[0.9rem] font-medium transition-transform duration-200 hover:-translate-y-px active:scale-[0.98]"
            style="border: 1px solid var(--ink); color: var(--ink);"
          >
            <IconWhatsApp class="h-4 w-4" />
            Ask on WhatsApp
          </a>
        </div>
      </div>
    </div>

    <div class="mt-14 grid gap-5 md:grid-cols-3">
      {pillars.map((p) => (
        <article class="sheet flex flex-col p-8" data-reveal>
          <img src={`/media/icons/${p.icon}.svg`} alt="" aria-hidden="true" width="40" height="40" class="h-10 w-10" />
          <h3 class="display mt-6 text-[1.5rem]">{p.k}</h3>
          <p class="mt-3 mb-8 text-[0.95rem] leading-relaxed">{p.d}</p>
        </article>
      ))}
    </div>
  </div>
</section>
