---
/**
 * Global navigation. A dark glass pill floating over the page, per Figma
 * (Nav, 157:925). It is fixed, so it takes no space in the flow: the Page
 * layout pads the top of every page except the homepage, whose hero runs
 * underneath it.
 *
 * Items point at real routes rather than on-page anchors, because the site
 * is six pages now, not one. "Why Cellove" is the exception: it is Section 2
 * of the homepage, so it stays an anchor.
 */
import { Icon } from 'astro-icon/components';

const links = [
  { href: '/#why-us', label: 'Why Cellove' },
  { href: '/science', label: 'Our Science' },
  { href: '/health', label: 'Health & Wellness' },
  { href: '/about', label: 'About Us' },
  { href: '/journal', label: 'Journal' },
];
---
<header class="pointer-events-none fixed inset-x-0 top-3 z-50 px-3 sm:px-5 lg:top-[43px] lg:px-[67px]">
  <nav
    class="nav-pill pointer-events-auto relative mx-auto flex h-14 max-w-[1306px] items-center justify-between gap-6 rounded-full pr-2 pl-5 lg:h-[63px] lg:pr-3 lg:pl-6"
    aria-label="Primary"
  >
    <a href="/" class="flex shrink-0 items-center" aria-label="Cellove Wellness, home">
      <img src="/media/logo-white.svg" alt="Cellove Wellness" width="149" height="36" class="h-8 w-auto lg:h-9" />
    </a>

    <ul class="absolute left-1/2 hidden -translate-x-1/2 items-center gap-4 lg:flex">
      {links.map((l) => (
        <li>
          <a
            href={l.href}
            class="whitespace-nowrap text-[0.875rem] transition-opacity duration-200 hover:opacity-70"
            style="color: #fff;"
          >{l.label}</a>
        </li>
      ))}
    </ul>

    <div class="flex shrink-0 items-center gap-2">
      <a
        href="/contact"
        class="hidden whitespace-nowrap rounded-full px-[22px] py-2.5 text-[0.875rem] font-medium transition-transform duration-200 hover:-translate-y-px active:scale-[0.98] md:inline-block"
        style="background: #fff; color: var(--ink);"
      >Contact Us</a>
      <button
        type="button"
        id="navToggle"
        class="grid h-10 w-10 place-items-center rounded-full lg:hidden"
        style="border: 1px solid rgba(255,255,255,0.3); color: #fff;"
        aria-expanded="false"
        aria-controls="navPanel"
        aria-label="Open menu"
      >
        <Icon aria-hidden="true" name="ph:list" class="h-5 w-5" />
      </button>
    </div>
  </nav>

  <div id="navPanel" hidden class="nav-pill pointer-events-auto mx-auto mt-2 max-w-[1306px] rounded-3xl lg:hidden">
    <ul class="flex flex-col px-5 py-3">
      {links.map((l) => (
        <li>
          <a href={l.href} class="block py-3 text-[0.95rem]" style="color: #fff; border-bottom: 1px solid rgba(255,255,255,0.14);">{l.label}</a>
        </li>
      ))}
      <li class="pt-4 pb-2">
        <a href="/contact" class="block rounded-full px-5 py-3 text-center text-[0.9rem] font-medium" style="background: #fff; color: var(--ink);">Contact Us</a>
      </li>
    </ul>
  </div>
</header>

<script>
  const btn = document.getElementById('navToggle');
  const panel = document.getElementById('navPanel');
  btn?.addEventListener('click', () => {
    const open = btn.getAttribute('aria-expanded') === 'true';
    btn.setAttribute('aria-expanded', String(!open));
    btn.setAttribute('aria-label', open ? 'Open menu' : 'Close menu');
    if (panel) panel.hidden = open;
  });
  panel?.querySelectorAll('a').forEach((a) =>
    a.addEventListener('click', () => {
      btn?.setAttribute('aria-expanded', 'false');
      if (panel) panel.hidden = true;
    })
  );
</script>
