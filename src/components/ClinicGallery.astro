---
/**
 * Four photographs of the clinic at Pavilion Damansara Heights, used on the
 * About and Contact pages. All cropped to one 3:4 frame so the row reads as a
 * set; the entrance shot is taller than the rest and loses a little ceiling
 * and floor, never the logo.
 */
const photos = [
  { src: '/media/clinic-entrance.webp', w: 608, h: 1080, pos: 'center 45%', alt: 'The clinic entrance: a curved white wall with the illuminated Cellove Wellness logo under a ring of light.' },
  { src: '/media/clinic-lounge.webp', w: 810, h: 1080, pos: 'center', alt: 'The lounge, with soft seating, glass-walled rooms and a window over the city.' },
  { src: '/media/clinic-chair.webp', w: 810, h: 1080, pos: 'center', alt: 'A green armchair and a sheepskin rug in a quiet corner of the clinic.' },
  { src: '/media/clinic-treatment.webp', w: 810, h: 1080, pos: 'center', alt: 'A treatment room with two reclining armchairs and a window view.' },
];

const { ground = 'white' } = Astro.props;
---
<section class={ground === 'beige' ? 'ground-beige edge-top' : 'ground-white edge-top'}>
  <div class="mx-auto max-w-[1440px] px-5 py-20 sm:px-8 lg:py-24">
    <div class="flex flex-col gap-4 sm:flex-row sm:items-end sm:justify-between">
      <div>
        <p class="label" data-reveal>The clinic</p>
        <h2 class="display mt-4 text-[2rem] leading-[1.15] sm:text-[2.4rem]" data-reveal>A calm place to talk things through.</h2>
      </div>
      <p class="max-w-[36ch] text-[0.95rem] leading-relaxed" style="color: var(--graphite);" data-reveal>
        Pavilion Damansara Heights, Kuala Lumpur.
      </p>
    </div>

    <div class="mt-10 grid grid-cols-2 gap-3 sm:gap-5 lg:grid-cols-4">
      {photos.map((p) => (
        <img
          src={p.src} alt={p.alt} width={p.w} height={p.h}
          loading="lazy" decoding="async"
          class="w-full rounded-xl object-cover"
          style={`aspect-ratio: 3 / 4; object-position: ${p.pos}; background: var(--beige);`}
          data-reveal
        />
      ))}
    </div>
  </div>
</section>
