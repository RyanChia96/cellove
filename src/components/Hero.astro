---
/**
 * Hero. Copy left, cell imagery right.
 *
 * The still is the load-bearing element and always renders. The video layer
 * sits on top at opacity 0 and only fades in once it is genuinely playing,
 * so reduced-motion, no-JS, phone and data-saver visitors all get the still.
 * Drop a clip at /media/cellove-hero.mp4 and it activates with no code change.
 *
 * The imagery is art direction, not a micrograph of anything observed at
 * Cellove, and is never captioned as a specimen.
 *
 * The clip carries no audio track. It is a muted decorative loop, so an audio
 * stream would be bytes nobody can ever hear.
 */
import { Icon } from 'astro-icon/components';
import IconWhatsApp from './IconWhatsApp.astro';
import { WHATSAPP_HREF } from '../lib/site';
---
<section class="relative overflow-hidden" style="background: #000; color: #fff;">
  <div class="relative z-10 mx-auto grid max-w-[1440px] items-center gap-10 px-5 pt-24 pb-28 sm:px-8 lg:grid-cols-12 lg:gap-0 lg:px-0 lg:pt-0 lg:pb-0 lg:min-h-[58rem]">
    <div class="lg:col-span-6 lg:py-40 lg:pl-16 xl:pl-20">
      <h1 class="display text-[2.6rem] sm:text-[3.4rem] lg:text-[4.25rem]" style="color: #fff;" data-reveal>
        Self Love Begins<br />With <span style="color: #c8a46a;">Cellove</span>
      </h1>

      <p
        class="mt-7 max-w-[32rem] text-[1.02rem] leading-relaxed sm:text-[1.06rem]"
        style="color: rgba(255,255,255,0.88);"
        data-reveal
      >
        Better health decisions begin with better understanding. Doctor-led care,
        guided by evidence rather than trend.
      </p>

      <div class="mt-10 flex flex-col gap-3 sm:flex-row sm:items-center sm:gap-4" data-reveal>
        <a
          href="/contact"
          class="inline-flex items-center justify-center gap-2 whitespace-nowrap rounded-full px-7 py-3.5 text-[0.9rem] font-medium transition-transform duration-200 hover:-translate-y-px active:scale-[0.98]"
          style="background: #c8a46a; color: var(--ink);"
        >
          Start Your Cellove Journey
          <Icon aria-hidden="true" name="ph:arrow-right" class="h-4 w-4" />
        </a>
        <a
          href={WHATSAPP_HREF}
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center justify-center gap-2 whitespace-nowrap rounded-full px-7 py-3.5 text-[0.9rem] font-medium transition-transform duration-200 hover:-translate-y-px active:scale-[0.98]"
          style="border: 1px solid #fff; color: #fff;"
        >
          <IconWhatsApp class="h-4 w-4" />
          WhatsApp Us
        </a>
      </div>
    </div>
  </div>
  {/* Full-bleed media layer behind the copy. The fade is solid black under the
      text and clears to nothing on the right, so the footage reads as emerging
      from the page. */}
  <div class="absolute inset-0 -z-0" aria-hidden="true">
    <img
      src="/media/hero-cells.jpg"
      alt=""
      fetchpriority="high"
      decoding="async"
      width="602"
      height="801"
      class="h-full w-full object-cover"
      style="object-position: right center;"
    />
    <video
      id="heroVideo"
      class="hero-video absolute inset-0 hidden h-full w-full object-cover lg:block"
      muted loop playsinline preload="none"
      tabindex="-1"
      poster="/media/hero-cells.jpg"
      data-mp4="/media/cellove-hero.mp4"
      style="object-position: right center;"
    ></video>
    <div class="hero-fade pointer-events-none absolute inset-0"></div>
  </div>
</section>

<script>
  (() => {
    const video = document.getElementById('heroVideo');
    if (!(video instanceof HTMLVideoElement)) return;

    const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    const narrow = window.matchMedia('(max-width: 1023px)').matches;
    // @ts-ignore - saveData is not in the standard lib types
    const saveData = Boolean(navigator.connection && navigator.connection.saveData);
    if (reduce || narrow || saveData) return;

    const mp4 = video.dataset.mp4;
    if (!mp4) return;

    const source = document.createElement('source');
    source.src = mp4;
    source.type = 'video/mp4';
    video.appendChild(source);

    video.addEventListener('playing', () => video.classList.add('is-playing'), { once: true });
    video.preload = 'auto';
    video.load();

    const tryPlay = () => {
      const p = video.play();
      // Autoplay can be refused by policy. The still stays up, which is a
      // perfectly good hero, so there is nothing to recover.
      if (p && typeof p.catch === 'function') p.catch(() => {});
    };
    tryPlay();

    if ('IntersectionObserver' in window) {
      const io = new IntersectionObserver(
        (entries) => {
          for (const e of entries) e.isIntersecting ? tryPlay() : video.pause();
        },
        { threshold: 0.1 }
      );
      io.observe(video);
    }
    document.addEventListener('visibilitychange', () => {
      document.hidden ? video.pause() : tryPlay();
    });
  })();
</script>
