---
/**
 * Hero. Copy left, cell imagery right.
 *
 * The still is the load-bearing element and always renders. The video layer
 * sits on top at opacity 0 and only fades in once it is genuinely playing,
 * so reduced-motion, no-JS, phone and data-saver visitors all get the still.
 * Drop a clip at /media/hero-cells.mp4 and it activates with no code change.
 *
 * The imagery is art direction, not a micrograph of anything observed at
 * Cellove, and is never captioned as a specimen.
 */
import { Icon } from 'astro-icon/components';
import { WHATSAPP_HREF } from '../lib/site';
---
<section class="ground-white relative overflow-hidden">
  <div class="mx-auto grid max-w-[1440px] items-center gap-10 px-5 pt-16 pb-20 sm:px-8 lg:grid-cols-12 lg:gap-0 lg:px-0 lg:pt-0 lg:pb-0">
    <div class="lg:col-span-6 lg:py-32 lg:pl-16 xl:pl-20">
      <h1 class="display text-[2.6rem] sm:text-[3.4rem] lg:text-[4.25rem]" data-reveal>
        Self Love Begins<br />With <span style="color: var(--annot);">Cellove</span>
      </h1>

      <p
        class="mt-7 max-w-[32rem] text-[1.02rem] leading-relaxed sm:text-[1.06rem]"
        style="color: var(--graphite);"
        data-reveal
      >
        Better health decisions begin with better understanding. Doctor-led care,
        guided by evidence rather than trend.
      </p>

      <div class="mt-10 flex flex-col gap-3 sm:flex-row sm:items-center sm:gap-4" data-reveal>
        <a
          href="/contact"
          class="inline-flex items-center justify-center gap-2 whitespace-nowrap rounded-full px-7 py-3.5 text-[0.9rem] font-medium transition-transform duration-200 hover:-translate-y-px active:scale-[0.98]"
          style="background: var(--ink); color: var(--white);"
        >
          Start Your Cellove Journey
          <Icon aria-hidden="true" name="ph:arrow-right" class="h-4 w-4" />
        </a>
        <a
          href={WHATSAPP_HREF}
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center justify-center gap-2 whitespace-nowrap rounded-full px-7 py-3.5 text-[0.9rem] font-medium transition-transform duration-200 hover:-translate-y-px active:scale-[0.98]"
          style="border: 1px solid var(--ink); color: var(--ink);"
        >
          <Icon aria-hidden="true" name="ph:whatsapp-logo" class="h-4 w-4" />
          WhatsApp Us
        </a>
      </div>
    </div>

    <div class="relative lg:col-span-6 lg:h-[46rem]">
      <img
        src="/media/hero-cells.jpg"
        alt=""
        aria-hidden="true"
        fetchpriority="high"
        decoding="async"
        width="602"
        height="801"
        class="h-64 w-full object-cover sm:h-96 lg:absolute lg:inset-0 lg:h-full"
      />
      <video
        id="heroVideo"
        class="hero-video absolute inset-0 hidden h-full w-full object-cover lg:block"
        muted loop playsinline preload="none"
        aria-hidden="true" tabindex="-1"
        poster="/media/hero-cells.jpg"
      ></video>
      {/* To switch the hero from still to video: drop the clip at
          /media/hero-cells.mp4 and add data-mp4="/media/hero-cells.mp4" to the
          video above. Left off for now so the page does not request a file
          that is not there. */}
    </div>
  </div>
</section>

<script>
  (() => {
    const video = document.getElementById('heroVideo');
    if (!(video instanceof HTMLVideoElement)) return;

    const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    const narrow = window.matchMedia('(max-width: 1023px)').matches;
    // @ts-ignore - saveData is not in the standard lib types
    const saveData = Boolean(navigator.connection && navigator.connection.saveData);
    if (reduce || narrow || saveData) return;

    const mp4 = video.dataset.mp4;
    if (!mp4) return;

    const source = document.createElement('source');
    source.src = mp4;
    source.type = 'video/mp4';
    video.appendChild(source);

    video.addEventListener('playing', () => video.classList.add('is-playing'), { once: true });
    video.preload = 'auto';
    video.load();

    const tryPlay = () => {
      const p = video.play();
      // Autoplay can be refused by policy. The still stays up, which is a
      // perfectly good hero, so there is nothing to recover.
      if (p && typeof p.catch === 'function') p.catch(() => {});
    };
    tryPlay();

    if ('IntersectionObserver' in window) {
      const io = new IntersectionObserver(
        (entries) => {
          for (const e of entries) e.isIntersecting ? tryPlay() : video.pause();
        },
        { threshold: 0.1 }
      );
      io.observe(video);
    }
    document.addEventListener('visibilitychange', () => {
      document.hidden ? video.pause() : tryPlay();
    });
  })();
</script>
