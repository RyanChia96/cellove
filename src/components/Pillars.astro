---
/** Asymmetric bento, exactly four cells for four pillars.
 *  Each cell carries a different surface so the grid is not white on white. */
import { Icon } from 'astro-icon/components';

const pillars = [
  {
    icon: 'ph:atom',
    title: 'Cell Technology',
    body: 'Exploring scientifically supported cellular approaches relevant to the individual. The technology is a tool, never the strategy by itself.',
    span: 'lg:col-span-7',
    surface: 'background: var(--stone-deep);',
    tone: 'var(--ink)',
    sub: 'var(--ink-soft)',
    invert: false,
  },
  {
    icon: 'ph:drop-half',
    title: 'Absorption Science',
    body: 'Considering how an intervention is delivered and made available to the body.',
    span: 'lg:col-span-5',
    surface: 'background: var(--invert-bg);',
    tone: 'var(--invert-fg)',
    sub: 'var(--invert-fg-soft)',
    invert: true,
  },
  {
    icon: 'ph:chart-line',
    title: 'Data & Science',
    body: 'Using available scientific and clinical evidence to inform what we recommend.',
    span: 'lg:col-span-5',
    surface: 'background: var(--stone);',
    tone: 'var(--ink)',
    sub: 'var(--ink-soft)',
    invert: false,
  },
  {
    icon: 'ph:stethoscope',
    title: 'Doctor-led Care',
    body: 'Every journey begins with professional medical assessment and guidance, and continues under it.',
    span: 'lg:col-span-7',
    surface: 'background: var(--paper); border: 1px solid var(--hairline);',
    tone: 'var(--ink)',
    sub: 'var(--ink-soft)',
    invert: false,
  },
];
---
<section id="science" style="background: color-mix(in srgb, var(--stone) 42%, var(--paper));">
  <div class="mx-auto max-w-[1400px] px-5 py-24 sm:px-8 lg:py-32">
    <p class="text-[0.72rem] uppercase tracking-[0.26em]" style="color: var(--rose-deep);" data-reveal>
      The Cellove method
    </p>
    <h2 class="display mt-5 max-w-[24ch] text-[2.1rem] sm:text-[2.7rem] lg:text-[3rem]" data-reveal>
      Four things we weigh before anything is recommended.
    </h2>

    <div class="mt-14 grid gap-4 lg:grid-cols-12">
      {pillars.map((p) => (
        <article class={`${p.span} flex flex-col p-8 sm:p-10 lg:p-11`} style={p.surface} data-reveal>
          <Icon aria-hidden="true" name={p.icon} class="h-7 w-7" style={`color: ${p.invert ? 'var(--invert-accent)' : 'var(--rose-deep)'};`} />
          <h3 class="display mt-6 text-[1.5rem] sm:text-[1.7rem]" style={`color: ${p.tone};`}>{p.title}</h3>
          <p class="mt-3 max-w-[38ch] text-[0.97rem] leading-relaxed" style={`color: ${p.sub};`}>{p.body}</p>
        </article>
      ))}
    </div>
  </div>
</section>
