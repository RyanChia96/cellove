---
/**
 * Section 4, the blog teaser. Same card treatment as the Journal page so the
 * two read as one thing.
 *
 * Cards come from lib/journal: real posts first, placeholders after.
 */
import { Icon } from 'astro-icon/components';
import { getCards } from '../lib/journal';

const { cards } = await getCards(3);

---
<section id="journal" class="ground-beige edge-top">
  <div class="mx-auto max-w-[1440px] px-5 py-20 sm:px-8 lg:py-24">
    <div class="flex flex-col gap-6 sm:flex-row sm:items-end sm:justify-between">
      <div>
        <h2 class="display max-w-[16ch] text-[2.1rem] sm:text-[2.6rem]" data-reveal>The Cellove Journal.</h2>
        <p class="mt-5 max-w-[48ch] text-[1.02rem] leading-relaxed" data-reveal>
          Plain explanations of how cellular health works, written to be understood
          rather than to impress.
        </p>
      </div>
      <a href="/journal" class="inline-flex items-center gap-2 text-[0.92rem] font-medium" style="color: var(--ink);" data-reveal>
        All writing
        <Icon aria-hidden="true" name="ph:arrow-right" class="h-4 w-4" />
      </a>
    </div>

    <div class="mt-12 grid gap-8 md:grid-cols-3">
      {cards.map((p) => (
        <a href={p.href} class="group block" data-reveal>
          <img
            src={p.img}
            alt={p.alt}
            loading="lazy" decoding="async" width="816" height="448"
            class="w-full object-cover"
            style="aspect-ratio: 16 / 9; background: var(--sheet);"
          />
          <p class="label mt-5">{p.meta}</p>
          <h3 class="display mt-2 text-[1.35rem] transition-colors duration-200 group-hover:text-[var(--annot)]">{p.k}</h3>
          <p class="mt-2 text-[0.93rem] leading-relaxed">{p.d}</p>
        </a>
      ))}
    </div>
  </div>
</section>
