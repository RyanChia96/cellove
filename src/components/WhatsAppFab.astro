---
/** Persistent WhatsApp entry point, fixed bottom-right on every page. */
import { Icon } from 'astro-icon/components';
import { WHATSAPP_HREF } from '../lib/site';
---
<a
  href={WHATSAPP_HREF}
  target="_blank"
  rel="noopener noreferrer"
  class="safe-bottom safe-right fixed z-50 grid h-14 w-14 place-items-center rounded-full transition-transform duration-200 hover:-translate-y-0.5 active:scale-95"
  style="background: var(--dark); color: var(--white); box-shadow: 0 8px 24px rgb(41 49 57 / 0.32);"
  aria-label="Message Cellove Wellness on WhatsApp"
>
  <Icon aria-hidden="true" name="ph:whatsapp-logo" class="h-6 w-6" />
</a>
